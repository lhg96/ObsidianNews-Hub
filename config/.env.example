# 환경변수 설정 예시 파일
# 실제 사용시 .env 파일로 복사하여 사용하세요

# 환경 설정
ENVIRONMENT=development

# 데이터베이스 설정
DATABASE_PATH=./data/chroma_db
DATABASE_COLLECTION_NAME=news_articles

# 크롤러 설정  
CRAWLER_MAX_WORKERS=5
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_COUNT=3
CRAWLER_DELAY_BETWEEN_REQUESTS=1.0

# 마크다운 생성 설정
MARKDOWN_OUTPUT_DIR=./output
MARKDOWN_FILENAME=Today News.md
MARKDOWN_KEYWORDS_COUNT=5
MARKDOWN_CONTENT_PREVIEW_LENGTH=300

# 로깅 설정
LOGGING_LEVEL=INFO
LOGGING_FILE=./logs/app.log
LOGGING_MAX_BYTES=10485760
LOGGING_BACKUP_COUNT=5

# 옵션: Obsidian 특정 설정 (createMD.py에서 사용)
OBSIDIAN_VAULT_PATH=/Users/hyun/OneDrive/문서/50.obsidian/WH2K/02.News/RSS

# 알림 설정 (향후 기능)
# NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFICATION_EMAIL=admin@example.com